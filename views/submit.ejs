<%- include('./partials/header') %>

<div class="container">
    <div class="jumbotron centered text-center">
        <i class="fas fa-key fa-6x"></i>
        <h1 class="display-3">Secrets</h1>
        <p class="lead">Don't keep your secrets, share them anonymously!</p>
        <form action="/submit" method="POST">
            <div class="form-group mb-3">
                <input type="text" name="secret" class="form-control text-center" placeholder="What's your secret?">
            </div>
            <button type="submit" class="btn btn-dark">Submit</button>
        </form>
    </div>
</div>

<%- include('./partials/footer') %>
